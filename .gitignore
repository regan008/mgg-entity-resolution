# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets — never commit
.env

# OS
.DS_Store

# Design mockups (reference only, not part of the app)
dashboard-design-docs/

# SQLite scratch (live WAL files)
*.db-shm
*.db-wal

# SQLite database — too large for git and not diffable. Versioned as gzipped
# CSVs in data/ and results/; rebuild with `python3 db_snapshot.py build`.
mgg.db

# working/{STATE}/ — commit only what can't be regenerated (human judgment and
# paid AI output); everything else is rebuilt from data/ by stages 1-3 plus
# `adjudicate.py STATE --restore`. Whitelisted so new large intermediates are
# excluded by default rather than committed by accident.
working/*/*
!working/*/ai_decisions.csv.gz
!working/*/human_review_decisions.csv
!working/*/venue_edit_log.csv
!working/*/excluded_records.csv
!working/*/venue_assignments_draft.csv
!working/*/venue_assignments_approved.csv
!working/*/group_flags.csv
!working/*/consolidated_groups.csv
*.tmp
